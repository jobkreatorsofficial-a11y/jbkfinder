# One webhook per sourcing platform. Each points at the n8n workflow that
# sources from that portal and writes results to the Google Sheet.
N8N_WEBHOOK_URL_SHINE=https://n8n-production-c2e8.up.railway.app/webhook/shine-source
N8N_WEBHOOK_URL_FOUNDIT=<check the Foundit workflow's webhook path in n8n>
N8N_WEBHOOK_URL_APNA=https://n8n-production-c2e8.up.railway.app/webhook/apna-source

# Legacy single-platform variable. Still read as a fallback for Shine so an
# existing deployment keeps working until N8N_WEBHOOK_URL_SHINE is set.
N8N_WEBHOOK_URL=https://n8n-production-c2e8.up.railway.app/webhook/shine-source

# A Google service account that can READ your candidate sheet.
# Share the sheet with this email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The service account private key. Keep the literal \n sequences; the app converts them.
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIExxxx...\n-----END PRIVATE KEY-----\n"

# Supabase — the candidate + recruiter-account store the dashboard reads/writes.
# Service role is server-only (used by the Next API routes); it bypasses RLS and
# must never be exposed to the browser. Run supabase/migrations/0001_init.sql and
# supabase/seed.sql once to create the schema.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
